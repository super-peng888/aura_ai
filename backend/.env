# ============================================
# 对象存储 OSS（RustFS，本地部署，S3 兼容）
# ============================================
OSS_ENDPOINT=http://localhost:9000
# RustFS 默认凭据为 rustfsadmin/rustfsadmin；若启动 RustFS 时用
# RUSTFS_ROOT_USER / RUSTFS_ROOT_PASSWORD 设了自定义值，请改成对应值
OSS_ACCESS_KEY=rustfsadmin
OSS_SECRET_KEY=rustfsadmin
OSS_BUCKET=aura-ai
# 如果 RustFS 配了对外可直接访问的公开地址，可填此项让图片/文件走直链；
# 留空则由后端生成预签名 URL
OSS_PUBLIC_URL=

# ============ MCP 外部工具服务器 ============
# MCP 服务器请在页面配置：配置中心 → MCP 工具（存 mcp_servers 表，保存即生效）。
# 下面的 MCP_SERVERS 为遗留兜底（JSON 字典，同名时页面配置优先），一般留空。
# 示例：MCP_SERVERS={"local": {"transport": "streamable_http", "url": "http://localhost:9000/mcp"}}
MCP_SERVERS=
